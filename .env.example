# Copy to .env and fill in real values. .env is gitignored; this file is not.

# Where the agent finds Postgres. Matches compose.yaml for local dev.
DATABASE_URL=postgres://agent:agent@localhost:5433/jobs?sslmode=disable

# Free key from https://aistudio.google.com (Get API key). Never commit the real one.
GEMINI_API_KEY=your-key-here
# Pinned model version (aliases like "-latest" can change under you).
GEMINI_MODEL=gemini-3.5-flash-lite

# What the follow-up emails say about you (optional; defaults are in cmd/agent/main.go).
# FOLLOWUP_PROJECT_URL=https://github.com/you/your-project
# FOLLOWUP_PROJECT_DESC=one or two plain sentences about the project
# FOLLOWUP_SIGNOFF=Regards,\nVasanth   (leave unset if your Gmail signature already has a sign-off)
